{
  "name": "ts-calculator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A scientific calculator in pure TypeScript with a Word-style equation editor, statically hosted on Vercel.",
  "scripts": {
    "predev": "node scripts/copy-mathlive-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-mathlive-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@cortex-js/compute-engine": "^0.153.0",
    "mathlive": "^0.111.1"
  }
}
